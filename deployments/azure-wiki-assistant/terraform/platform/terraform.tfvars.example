entra_client_id = "00000000-0000-0000-0000-000000000000"
# Export TF_VAR_entra_client_secret from a protected secret; never add it here.

github_organization = "REPLACE_WITH_GITHUB_ORGANIZATION"
github_repository   = "REPLACE_WITH_APPLICATION_REPOSITORY"

