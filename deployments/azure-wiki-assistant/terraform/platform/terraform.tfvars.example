}

embedding_model = {
  deployment_name = "embedding"
  model_name       = "REPLACE_WITH_APPROVED_EMBEDDING_MODEL"
  model_version    = "REPLACE_WITH_APPROVED_MODEL_VERSION"
  sku_name         = "REPLACE_WITH_APPROVED_DEPLOYMENT_SKU"
  capacity         = 1
}

embedding_dimensions = 1536 # Replace when the approved embedding model uses a different dimension.

