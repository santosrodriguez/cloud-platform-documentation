private_endpoint_subnet_id         = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/REPLACE/providers/Microsoft.Network/virtualNetworks/REPLACE/subnets/REPLACE"

manage_private_dns_zone_groups = true
private_dns_zone_ids = {
  app_service                = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/REPLACE/providers/Microsoft.Network/privateDnsZones/privatelink.azurewebsites.net"
  automation_agentsvc        = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/REPLACE/providers/Microsoft.Network/privateDnsZones/privatelink.agentsvc.azure-automation.net"
